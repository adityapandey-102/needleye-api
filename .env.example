NODE_ENV=development
API_PORT=4000
# One origin, or a comma-separated allow-list (exact match, no wildcard) --
# e.g. add the machine's LAN IP for phone testing:
#   CORS_ALLOWED_ORIGIN=http://localhost:3000,http://192.168.1.8:3000
CORS_ALLOWED_ORIGIN=http://localhost:3000
# Origin of the Next.js app. Used server-side to build absolute links the user
# opens elsewhere: the password-reset email link AND the Master Tailor QR-login
# URL (the QR encodes `${WEB_APP_URL}/qr-login?token=...`). For phone/mobile
# testing on the local network, set this to the machine's LAN IP so a scanned
# QR resolves on the phone (localhost would point at the phone itself):
#   WEB_APP_URL=http://192.168.1.8:3000
WEB_APP_URL=http://localhost:3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Queries slower than this many ms are logged at WARN (slow-query observability).
SLOW_QUERY_MS=250
# Day of the month an accounting period begins, for the monthly revenue report
# (GET /orders/revenue). 1 = calendar months (default). Set to e.g. 7 for a
# 7th-to-6th billing cycle. Must be 1-28 (avoids month-length edge cases).
ACCOUNTING_CYCLE_START_DAY=1
# Auth-endpoint brute-force protection (in-memory): window length + max attempts
# per IP per window. Applies only to /auth/* (login, refresh, reset, qr-login, ...).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

# From `npx supabase start` output in local dev; from Supabase project
# settings in prod. SUPABASE_SERVICE_ROLE_KEY is server-only -- never expose
# it to the client or commit it. SUPABASE_ANON_KEY is used by the Auth module
# for sign-in/refresh/password-reset/code-exchange (the same key a public
# client would use) -- also server-only here, since needleye-web never talks
# to Supabase directly anymore.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Plain Postgres connection string -- every repository's actual data access
# goes through this via Drizzle (src/common/database/drizzle-client.ts), not
# through Supabase's SDK/PostgREST. The default already matches the local
# Supabase CLI stack's exposed Postgres port; swapping Postgres hosts in
# prod is just changing this one value.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
STORAGE_BUCKET_NAME=order-images
