NODE_ENV=development
API_PORT=4000
CORS_ALLOWED_ORIGIN=http://localhost:3000

# From `pnpm supabase:start` output in local dev; from Supabase project
# settings in prod. SUPABASE_SERVICE_ROLE_KEY is server-only -- never expose
# it to the client or commit it.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
STORAGE_BUCKET_NAME=order-images
